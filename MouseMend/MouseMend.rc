/////////////////////////////////////////////////////////////////////////////
// English resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000904b0"
        BEGIN
            VALUE "CompanyName", APP_COMPANY
            VALUE "FileDescription", APP_NAME
            VALUE "FileVersion", APP_VERSION_STRING ".0"
            VALUE "InternalName", APP_NAME ".exe"
            VALUE "LegalCopyright", APP_COPYRIGHT
            VALUE "OriginalFilename", APP_NAME ".exe"
            VALUE "ProductName", APP_NAME
            VALUE "ProductVersion", APP_VERSION_STRING ".0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x9, 1200
    END
END

#endif    // English resources
/////////////////////////////////////////////////////////////////////////////


/////////////////////////////////////////////////////////////////////////////
// Neutral (Default) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_NEUD)
LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MAINICON            ICON                    "resources/icon.ico"

IDI_NOTIFYICON          ICON                    "resources/notify.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Settings window
//
// All captions are empty on purpose: they are filled at run time from
// src/ui/language.c, so the dialog never shows a language other than the
// one the user selected. Dialog units keep the layout correct at any DPI.
//

// 311 instead of 299: the status bar needs 12 DLU that the footer buttons do
// not leave (the close button's bottom edge is at 293). Growing the dialog is
// the only way to add a bar without moving any existing control - shrinking the
// layout would mean re-placing the strip, the chart, both panes and four
// buttons, which is exactly the kind of change that breaks a template quietly.
IDD_SETTINGS DIALOGEX 0, 0, 477, 311
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // The bottom bar, created first so it sits under everything else in the
    // z-order. Its geometry here is only a starting position: the control moves
    // itself to the bottom of the client area on WM_SIZE and takes its height
    // from the font, which is what keeps it correct at any DPI.
    CONTROL         "", IDC_STATUSBAR, "msctls_statusbar32", WS_CHILD | WS_VISIBLE, 0, 299, 477, 12

    // The status strip: one owner-draw control painting five blocks - the
// overall verdict, then one per optional module. Idle they are squares with one
// dim character; the block under the pointer widens until its caption fits.
//
// One control instead of five, because the animation changes widths on every
// frame: five windows would mean five SetWindowPos calls per frame, and any
// one-pixel disagreement between them reads as blocks that never quite line up.
// Here all five are laid out inside a single client rectangle.
//
// y=5 h=11 to sit on the exact same baseline as the "version notes" button.
// The remaining width up to that button is left to the strip: a caption expands
// into it instead of moving its neighbours.
// SS_NOTIFY is not decoration: without it a static returns HTTRANSPARENT to
// WM_NCHITTEST, so the pointer falls through to the dialog and the control never
// sees WM_MOUSEMOVE - which would leave every block permanently collapsed.
    // The strip does not need the whole row: five blocks laid out from the left
    // add up to about 120 DLU in their widest state (paused verdict held open),
    // and the space to the right of them is empty dialog background. It is cut to
    // 336 so the always-on-top switch can sit between it and the version button,
    // which is where the user looks for it - the window that should stay on top
    // is the window he is reading.
    CONTROL         "", IDC_STATUS, "Static", SS_OWNERDRAW | SS_NOTIFY, 8, 5, 336, 11
    // An unmarked hot zone, the same height as the strip: 57 DLU is 100 px at
    // 96 dpi. Nothing is drawn here until the pointer arrives, and a right click
    // opens a one item menu - the always-on-top switch lives there now, because a
    // checkbox in this row was visually louder than the thing it toggles. The
    // zone is a general spot for that kind of small extra, not a button.
    CONTROL         "", IDC_EGG_ZONE, "Static", SS_OWNERDRAW | SS_NOTIFY, 352, 5, 57, 11
    PUSHBUTTON      "", IDC_VERSION_NOTES, 420, 5, 48, 11
    GROUPBOX        "", IDC_GROUP_TEST, 7, 21, 237, 272
    // Six filters in one row, all on y=29. The widths are measured, not guessed:
    // each item is its longest caption plus 16 DLU for the glyph and padding. The
    // widest case per item is not always the same language - "Middle" (22 DLU)
    // beats "中键" (15), and "Side 1" (18) beats "侧一" (15). Together they are
    // 220 DLU inside a group that offers 230, so the window does not have to grow:
    // the plan said it did until the numbers were taken (design 2.5.1).
    // Anything that changes these six captions has to re-measure first.
    CONTROL         "", IDC_FILTER_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 29, 31, 10
    CONTROL         "", IDC_FILTER_LEFT, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 49, 29, 31, 10
    CONTROL         "", IDC_FILTER_MIDDLE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 84, 29, 38, 10
    CONTROL         "", IDC_FILTER_RIGHT, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 126, 29, 32, 10
    CONTROL         "", IDC_FILTER_X1, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 162, 29, 34, 10
    CONTROL         "", IDC_FILTER_X2, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 200, 29, 34, 10
    LTEXT           "", IDC_FILTER_HINT, 14, 40, 224, 9, SS_LEFT | SS_ENDELLIPSIS
    CONTROL         "", IDC_RIPPLE, "Static", SS_OWNERDRAW, 13, 51, 225, 236
    GROUPBOX        "", IDC_GROUP_STATS, 248, 21, 222, 68
    LTEXT           "", IDC_STATS, 254, 29, 210, 9, SS_LEFT | SS_ENDELLIPSIS
    LTEXT           "", IDC_BLOCKLOG_HDR, 255, 39, 208, 9
    // CONTROL rather than EDITTEXT: that macro adds WS_TABSTOP, and a read only
    // multiline edit answers WM_GETDLGCODE with DLGC_WANTTAB, so Tab lands in the
    // pane and does nothing - the keyboard user cannot get back out of it.
    CONTROL         "", IDC_BLOCKLOG, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL, 254, 49, 210, 34
    // The test log keeps the top half of the right column: it answers "did my
    // click get through", and it only needs a few rows to do it. The live log
    // below it takes the space the self check used to occupy - that pane was a
    // copy of what the support bundle already exports, while this one answers a
    // question nothing else in the window could: what happened in the programs
    // the user was actually working in.
    GROUPBOX        "", IDC_GROUP_LOG, 248, 94, 222, 72
    PUSHBUTTON      "", IDC_LOG_HELP, 420, 101, 48, 11
    LTEXT           "", IDC_TESTLOG_HDR, 255, 102, 160, 9
    CONTROL         "", IDC_TESTLOG, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL, 254, 112, 210, 48
    GROUPBOX        "", IDC_GROUP_LIVE, 248, 172, 222, 99
    LTEXT           "", IDC_LIVE_HDR, 255, 180, 208, 9
    // CONTROL rather than EDITTEXT for the same reason as the panes above: the
    // macro adds WS_TABSTOP and a read only multiline edit answers WM_GETDLGCODE
    // with DLGC_WANTTAB, which traps Tab inside the pane.
    CONTROL         "", IDC_LIVELOG, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL, 254, 190, 210, 75
    // Settings leads the row: every other button here is about the log, and the
    // window has no other way to say "the rest of the configuration lives
    // somewhere". The window it would open does not exist yet, so for now the
    // button explains that in the status bar - see the TODO on its handler.
    PUSHBUTTON      "", IDC_SETTINGS, 248, 277, 40, 16
    PUSHBUTTON      "", IDC_CLEAR, 292, 277, 58, 16
    PUSHBUTTON      "", IDC_OPEN_LOG, 354, 277, 60, 16
    DEFPUSHBUTTON   "", IDC_CLOSE, 424, 277, 46, 16
END

/////////////////////////////////////////////////////////////////////////////
//
// About window
//
// Same rule as the check-up window: every caption is filled at run time so the
// dialog can never show a language the user did not pick.
//

IDD_ABOUT DIALOGEX 0, 0, 300, 292
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "Static", SS_ICON, 14, 14, 32, 32
    LTEXT           "", IDC_ABOUT_TITLE, 56, 14, 230, 14, SS_LEFT
    LTEXT           "", IDC_ABOUT_VERSION, 56, 31, 230, 9, SS_LEFT
    LTEXT           "", IDC_ABOUT_DESC, 14, 56, 272, 40, SS_LEFT
    LTEXT           "", IDC_ABOUT_FEATURES, 14, 102, 272, 104, SS_LEFT
    LTEXT           "", IDC_ABOUT_LIMITS, 14, 198, 272, 52, SS_LEFT
    LTEXT           "", IDC_ABOUT_ORIGIN, 14, 255, 272, 9, SS_LEFT | SS_ENDELLIPSIS
    PUSHBUTTON      "", IDC_ABOUT_WEBSITE, 14, 269, 96, 16
    DEFPUSHBUTTON   "", IDC_ABOUT_CLOSE, 240, 269, 46, 16
END

/////////////////////////////////////////////////////////////////////////////
//
// Help window
//
// One template serves both help topics: the verdict glossary and the version
// notes. The body lives in a read-only edit so a long text scrolls instead of
// being cut off, and so it stays selectable.
//

IDD_HELP DIALOGEX 0, 0, 340, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_HELP_TITLE, 10, 8, 320, 9, SS_LEFT
    EDITTEXT        IDC_HELP_TEXT, 10, 20, 320, 210, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDC_HELP_CLOSE, 284, 234, 46, 14
END

#endif    // Neutral (Default) resources
