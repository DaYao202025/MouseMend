# Build outputs
bin/
*.obj
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.exp
*.res
*.idb
*.tlog
*.lastbuildstate
*.iobj
*.ipdb
*.recipe

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

# Resource editor cache: a binary blob Visual Studio rewrites on every save.
# It was committed by mistake at some point and produced nothing but noise.
*.aps

# Backup folder of rename_project.ps1; delete it once the rename is confirmed
.rename_backup/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
*.so
*.egg-info/

# Runtime output: the blocked-click history and the crash dumps land here, and a
# minidump carries raw stack memory. Never commit one by accident.
Log/
*.dmp

# Temporary files
*.tmp
*.temp
*.log
*.cache

# Signing material (generated by sign_release.ps1, machine specific)
*.pfx
MouseMend-selfsigned.cer

# Scratch: crash bundles, captured screenshots and draft notes, never source
MouseMend/doc/tmp/
MouseMend/doc/资料/
MouseMend/doc/1.txt